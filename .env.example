# Project.MilanoLibrary 环境变量配置

# === API Keys ===
# Google AI Studio API Key (Gemini, Nano Banana, etc.)
GOOGLE_API_KEY=AIzaSyCAh2obiDbiQL1A2YyO6NRTyVnvdUJn1aU

# Kimi API Key (OpenAI Compatible)
KIMI_API_KEY=sk-kimi-hc4Uzz8FPNEjn6OMzlIZspALgiNzuAAx3TU7xnvrfT0yVWRNGe08JOjhldbjiTfT

# === 后端配置 ===
# 后端服务端口
BACKEND_PORT=8000

# 后端主机地址
BACKEND_HOST=0.0.0.0

# 数据库 URL (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./milano_library.db

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# === 前端配置 ===
# 前端服务端口
FRONTEND_PORT=3000

# API 基础 URL
REACT_APP_API_URL=http://localhost:8000

# === 视频处理 ===
# 上传文件最大大小 (MB)
MAX_UPLOAD_SIZE=500

# 临时文件存储路径
TEMP_DIR=/tmp/milano_library

# === AI 配置 ===
# Gemini 模型选择
GEMINI_MODEL=gemini-2.0-flash

# Kimi 模型选择
KIMI_MODEL=moonshot-v1-8k

# 请求超时时间 (秒)
AI_TIMEOUT=60
